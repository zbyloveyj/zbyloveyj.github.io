    {
      "name": "大三巴遗址与周边",
      "city": "半岛历史城区",
      "district": "半岛历史城区",
      "level": "",
      "address": "",
      "sourceUrl": "https://www.macaotourism.gov.mo/zh-hans/sightseeing",
      "sourceAsOf": "2026-11-08检索",
      "detail": "先从广场看石立面的层次与雕刻，再读火灾后留下的遗址范围，区分教堂前壁、地基和后方展示。邻近哪咤庙与旧街可一起观察，理解不同信仰近距离共处；不把整片遗址当成完整教堂。现存立面与原教堂、学院的范围不同，先看图示再读雕刻。",
      "time": "1—2小时",
      "kind": "文化与风景",
      "history": "",
      "regionId": "macao",
      "regionName": "澳门",
