    },
    {
      "name": "澳门博物馆与大炮台",
      "city": "东望洋与望德堂",
      "district": "东望洋与望德堂",
      "level": "",
      "address": "",
      "sourceUrl": "https://www.macaotourism.gov.mo/zh-hans/sightseeing",
      "sourceAsOf": "2026-11-08检索",
      "detail": "在博物馆以海上交流、城市生活和传统工艺为线索读展，再到大炮台看山头与历史城区的空间关系。展柜中的生活物件可以与刚走过的老街互相验证；馆内与炮台户外分开预留时间。展陈与炮台观景性质不同，先读城防和贸易再看今日城市。",
      "time": "2—3小时",
      "kind": "文化与风景",
      "history": "",
      "regionId": "macao",
      "regionName": "澳门",
      "id": "macao-4869e7e6e090",
