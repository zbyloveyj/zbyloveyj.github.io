    {
      "name": "叶挺将军故居",
      "city": "东望洋与望德堂",
      "district": "澳门半岛贾伯乐提督街一带",
      "level": "",
      "address": "",
      "sourceUrl": "https://www.macaotourism.gov.mo/zh-hans/sightseeing",
      "sourceAsOf": "2026-11-08检索",
      "detail": "故居以住宅空间、文物及图文资料介绍叶挺与家人在澳门的生活片段。先读具体居住时间和家人与周边社会联系，再观察庭院、房间与展品的关系，不能把人物全部生平都当作发生在这座房子里。它适合与望德堂附近街区分段慢走，展览中的原件、复制品和场景复原应区别理解。",
      "time": "1—2小时",
      "kind": "纪念馆",
      "history": "",
      "regionId": "macao",
