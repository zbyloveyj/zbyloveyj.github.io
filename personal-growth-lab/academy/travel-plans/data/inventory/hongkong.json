    {
      "name": "香港故宫文化博物馆",
      "city": "尖沙咀与西九",
      "district": "尖沙咀与西九",
      "level": "",
      "address": "",
      "sourceUrl": "https://www.discoverhongkong.com/tc/attractions.html",
      "sourceAsOf": "2026-11-08检索",
      "detail": "以器物用途、工艺与宫廷生活为线索，比较陶瓷、书画或其他门类的展示。借展与馆藏轮换应看当期目录；看完一组文物后到海边休息，再回想它们与M+所谈视觉文化的差别。馆藏来源、借展和当期专题分清，不保证指定名品持续展出。",
      "time": "半天",
      "kind": "文化与风景",
      "history": "",
      "regionId": "hongkong",
      "regionName": "香港",
