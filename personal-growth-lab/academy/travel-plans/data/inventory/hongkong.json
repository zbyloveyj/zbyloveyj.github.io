    {
      "name": "香港历史博物馆",
      "city": "尖沙咀与西九",
      "district": "尖沙咀东",
      "level": "",
      "address": "",
      "sourceUrl": "https://www.discoverhongkong.com/tc/attractions.html",
      "sourceAsOf": "2026-11-08检索",
      "detail": "以馆方当期开放展览为准建立香港历史的时间线，先关注考古、港口、行业与社区如何相连，再将海滨和街区所见放回背景。常设展更新或部分展厅安排不能凭旧攻略推定，出发前查展览清单。展品、模型与历史照片彼此对照，比把一栋仿建街景当成全城过去更有收获。",
      "time": "半天",
      "kind": "博物",
      "history": "",
      "regionId": "hongkong",
      "regionName": "香港",
      "id": "hongkong-bc3855275672",
      "guideIndex": 1
    },
    {
