    {
      "name": "上海佘山国家森林公园",
      "city": "上海市",
      "district": "松江区",
      "level": "4A",
      "address": "松江区外青松公路9258号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "佘山山体与周边林地构成上海近郊少见的登高空间，西佘山的宗教、天文相关历史让自然步行之外还有文化线索。不同园区入口、开放建筑和山道分别安排，适合看松江地形与城市边缘，不需把所有山顶都走遍，古建与现代设施按说明区分。",
      "time": "半天—1天",
      "kind": "山林人文",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-45f28fdca38e",
      "guideIndex": 4
    },
    {
      "name": "上海豫园",
      "city": "上海市",
      "district": "黄浦区",
      "level": "4A",
      "address": "黄浦区豫园老街279号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "明代起建、后经历修整的江南园林，以池水、假山、厅堂和曲折游线组织小中见大的空间。与外围豫园商城、城隍庙并非同一参观内容，入园后可挑石景、漏窗和室内陈设慢看，理解园主生活与文人审美，不只在热门水岸机位停留。",
      "time": "2—3小时",
      "kind": "古典园林",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-e9d0f0ee2b7c",
      "guideIndex": 0
    },
    {
      "name": "金茂大厦88层观光厅",
      "city": "上海市",
      "district": "浦东新区",
      "level": "4A",
      "address": "浦东新区世纪大道88号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "位于陆家嘴金茂大厦高层的观光空间，可比较黄浦江弯曲、浦西街区与浦东高层建筑群。建筑采用层层收分的造型语言，是理解上海现代天际线的一处视点；高空项目与普通观景另查规则，天气和能见度比到达时刻更影响远眺效果。",
      "time": "1—2小时",
      "kind": "城市观景",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-b29a64b681f3",
      "guideIndex": 2
    },
    {
      "name": "上海城市规划展示馆",
      "city": "上海市",
      "district": "黄浦区",
      "level": "4A",
      "address": "黄浦区人民大道100号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "以城市发展、空间规划、模型和互动展示解释上海如何从滨水聚落发展为大城市。先看市域与黄浦江、苏州河关系，再选交通、公共空间或未来城市主题，适合在实地行走前建立地图概念。规划方案、历史记录与已建成项目要按展签区分。",
      "time": "2—3小时",
      "kind": "城市规划",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-65a94efe81ce",
      "guideIndex": 0
    },
    {
      "name": "东平国家森林公园",
      "city": "上海市",
      "district": "崇明区",
      "level": "4A",
      "address": "崇明区北沿公路2188号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "崇明岛中部的人工林地公园，以林间道路、草地和休闲空间为主，适合骑行、步行或家庭野餐。它展现人工造林与郊野游憩的结合，不是无需管理的原始森林；园内交通、游乐与步行路线分开选，季节和天气会影响树色及可参与活动。",
      "time": "半天—1天",
      "kind": "森林休闲",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-bc80e26c6f07",
      "guideIndex": 5
    },
    {
      "name": "上海动物园",
      "city": "上海市",
      "district": "长宁区",
      "level": "4A",
      "address": "长宁区虹桥路2381号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "长宁区的城市动物园以步行参观、动物展示与科普为主，园林环境也适合慢走。可挑灵长类、鸟类等一两类观察行为与栖息环境说明，不必追逐全部热门动物。动物是否出现与作息、照护有关，遵守投喂规定，和浦东野生动物园是不同目的地。",
      "time": "半天—1天",
      "kind": "动物科普",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-16016edbd6a9",
      "guideIndex": 6
    },
    {
      "name": "上海世纪公园",
      "city": "上海市",
      "district": "浦东新区",
      "level": "4A",
      "address": "浦东新区锦绣路1001号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
      "sourceAsOf": "2025-12-16",
      "detail": "浦东大型城市绿地把湖泊、草坪、林地与不同园林风格组织在一起，是陆家嘴高楼之外观察日常生活的空间。适合慢走、家庭休息或季节赏花，按入口选择小环线即可；花展与游乐另看当期安排，植物与人工园景共同构成特色，不需套用古园历史。",
      "time": "2—4小时",
      "kind": "城市公园",
      "history": "",
      "regionId": "shanghai",
      "regionName": "上海",
      "id": "shanghai-8b77758adb6c",
      "guideIndex": 2
    },
    {
      "name": "上海大观园",
      "city": "上海市",
      "district": "青浦区",
      "level": "4A",
      "address": "青浦区青商路701号",
      "sourceUrl": "https://whlyj.sh.gov.cn/4ajjq/20191008/0022-28627.html",
