{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CurateMicrobiota: complete CPU demonstration",
      "type": "debugpy",
      "request": "launch",
      "module": "curatemicrobiota",
      "args": ["pipeline", "--quick", "--out", "runs/debug-demo"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TinyGPT: follow the training loop",
      "type": "debugpy",
      "request": "launch",
      "module": "curatemicrobiota",
      "args": ["train-lm", "--steps", "40", "--out", "runs/debug-lm"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
